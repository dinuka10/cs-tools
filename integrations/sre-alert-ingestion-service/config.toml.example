[server]
# Total SIGTERM budget covering the three drains below; Choreo's grace period must be 30s or more.
shutdown_grace = "25s"
# After SIGTERM, /healthz answers 503 for this long before the listener closes.
drain_delay = "5s"
# How long a request waits for its ids, and how long in-flight requests get on shutdown.
request_wait = "10s"
# The allocator's own time to claim and write what is queued, even if requests overran.
allocator_drain = "10s"
read_timeout = "10s"
write_timeout = "30s"
# Keep-alive connections idle this long are closed.
idle_timeout = "60s"
# Bodies over this are answered 413 and never claim an id.
max_body_bytes = 1048576

[allocator]
# Alerts waiting to be claimed; when full, new webhooks get 503 immediately.
queue_size = 5000
# Memory cap on accepted, unfinished alerts before 503; about half the container memory limit.
queue_max_bytes = 268435456
# Max alerts claimed with a single compare-and-set on alert_seq.
max_batch = 200
# Parallel row writers per replica; ids are only claimed for free writers.
write_concurrency = 16
# Compare-and-set attempts per batch before its requests fail with 503.
claim_max_attempts = 20

[store]
# Attempts on the same id for errors other than throttling, before the filler row.
insert_attempts = 5
# Delay before the second attempt; doubles each time (250ms, 500ms, 1s, 2s).
insert_base_delay = "250ms"
# Per-query timeout for row inserts and read-backs.
query_timeout = "1.5s"
# Timeout for the alert_seq read and compare-and-set, longer so a slow claim isn't a failure.
claim_timeout = "5s"
# How long a throttled write retries before the filler row; must stay under alerts-core's gap_timeout (10m).
write_deadline = "5m"
# Read every inserted row back before answering 201. Costs 2 RU per alert; a Cosmos DB write is
# already durable when acknowledged, and alerts-core waits on an id it can't see yet.
read_back = false

[cassandra]
# Startup connection retry, so a transient blip doesn't crash-loop the pod.
connect_max_attempts = 5
connect_base_delay = "2s"
connect_timeout = "10s"

[wake]
# Timeout for the fire-and-forget POST /alertz to alerts-core.
timeout = "2s"

[reject]
# Window for one reject card per vendor + error class (max 10 per replica); the rest are counted.
window = "15m"
# How much of a rejected body the card shows.
body_preview_chars = 500

[fallback]
# DB-failure Chat cards per minute, per replica, before switching to one summary per minute.
cards_per_minute = 5
