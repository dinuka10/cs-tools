# Copy to .env and fill in real values. No quotes: docker --env-file keeps them literally.

# Cosmos DB for Apache Cassandra connection (same variables as sre-alert-core-service).
CASSANDRA_CONTACT_POINT=your-account.cassandra.cosmos.azure.com
CASSANDRA_KEYSPACE=alertintegration
CASSANDRA_KEY=your-cosmos-db-key
# Optional: defaults to the contact point's leading DNS label (Cosmos DB account name == username).
CASSANDRA_USERNAME=
# Optional: defaults to 10350.
CASSANDRA_PORT=10350

# alerts-core's POST /alertz, called per written batch; empty skips it and the 10s poll still runs.
ALERT_CORE_WAKE_URL=

# true checks vendor webhooks against integration_users (curl -u user:secret); false accepts all.
AUTH_ENABLED=false
# true logs what would be rejected but rejects nothing; use with AUTH_ENABLED during rollout.
AUTH_AUDIT_ONLY=false

# integration_users credential for the wake call (alerts-core's cmd/user); sent only over https.
ALERT_CORE_WAKE_USERNAME=
ALERT_CORE_WAKE_SECRET=

# Google Chat webhook URLs (comma-separated) for reject/DB-failure cards; empty only logs them.
FALLBACK_CHAT_WEBHOOK_URLS=

# Email per ?team= for SNS subscriptions, e.g. {"teams":{"ManagedCloud":"managed-cloud@example.com","Default":""}}
AWS_SNS_SUBSCRIPTION_NOTIFICATION_CONFIG=

# WSO2 email service for SNS subscription emails; empty EMAIL_BASE_URL still auto-confirms and logs.
EMAIL_BASE_URL=
EMAIL_TOKEN_URL=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_FROM_ADDRESS=

# Optional per-vendor overrides, JSON, same keys and shapes as the ServiceNow Edge API alert-config properties.
AWS_ALERT_CONFIG=
AZURE_ALERT_CONFIG=
DATADOG_ALERT_CONFIG=
ELASTICSEARCH_ALERT_CONFIG=
GCP_ALERT_CONFIG=
ICINGA_ALERT_CONFIG=
OPENOBSERVE_ALERT_CONFIG=
OPENSEARCH_ALERT_CONFIG=
PROMETHEUS_ALERT_CONFIG=
SITE24X7_ALERT_CONFIG=

# Optional path to config.toml; defaults to ./config.toml. Missing file = built-in defaults.
CONFIG_PATH=

# HTTP port. Optional: defaults to 8080.
PORT=8080
